# Algemene Applicatie-instellingen
APP_NAME="MKB Uptime & Formulier Bot"
DATABASE_URL="sqlite+aiosqlite:///./mkb_monitor.db"
CONFIRMATION_THRESHOLD=2
FAST_CHECK_INTERVAL_SECONDS=60
DEEP_CHECK_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true
ENABLE_PLAYWRIGHT=true

# Telegram Bot API (Gratis & direct voor MKB-notificaties)
TELEGRAM_BOT_TOKEN=""

# E-mail Notificaties (Resend API of SMTP)
RESEND_API_KEY=""
EMAIL_FROM="alerts@jouwmkbmonitor.nl"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# WhatsApp Adapter (Twilio WhatsApp API of Meta Cloud API Webhook)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
WHATSAPP_WEBHOOK_URL=""
